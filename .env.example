# ========================================
# Auth0 Configuration
# ========================================
# Get these values from your Auth0 Dashboard:
# https://manage.auth0.com/dashboard

# Your Auth0 domain (e.g., dev-abc123.us.auth0.com)
VITE_AUTH0_DOMAIN=your-auth0-domain.auth0.com

# Your Auth0 Application Client ID
VITE_AUTH0_CLIENT_ID=your-auth0-client-id

# The URL where Auth0 will redirect after authentication
# For local development: http://localhost:5173
# For production: https://your-domain.com
VITE_AUTH0_REDIRECT_URI=http://localhost:5173

# Optional: Auth0 Audience for API access
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# ========================================
# Power BI Configuration
# ========================================
VITE_POWERBI_CLIENT_ID=your-powerbi-client-id
VITE_POWERBI_TENANT_ID=your-tenant-id
VITE_POWERBI_REPORT_ID=your-report-id
VITE_POWERBI_WORKSPACE_ID=your-workspace-id

# ========================================
# Application Configuration
# ========================================
VITE_APP_NAME=Olympic Games BI Analytics
VITE_APP_URL=http://localhost:5173

# Session timeout in minutes
VITE_SESSION_TIMEOUT_MINUTES=480
